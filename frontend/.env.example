# Base URL of the BazaarKE API, including the /api/v1 prefix.
# Dev default (when unset): http://localhost:5002/api/v1
# Production (Netlify): https://<your-render-service>.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:5002/api/v1

# Stripe publishable key (safe to expose; the secret key stays on the backend).
# Leave blank to keep the card option disabled in the demo.
VITE_STRIPE_PUBLISHABLE_KEY=
